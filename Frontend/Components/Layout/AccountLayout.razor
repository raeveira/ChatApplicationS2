@inherits LayoutComponentBase
@inject UserService UserService
@inject CurrentUser CurrentUser
@inject NavigationManager Navigation

<div class="account-shell">
    <div class="account-window">
        <aside class="account-sidebar">
            <div class="account-profile">
                <Avatar Size="36" Color="#444" IconUrl="@me?.IconUrl" Name="@me?.Username" />
                <div>
                    @(me?.DisplayName ?? me?.Username)
                    <small><a href=""><i class="bi bi-arrow-left"></i> Back to chats</a></small>
                </div>
            </div>

            <form class="logout" method="post" action="/auth/logout">
                <AntiforgeryToken />
                <button type="submit"><i class="bi bi-box-arrow-left"></i> Log Out</button>
            </form>
        </aside>

        <div class="account-main">
            <div class="account-title">Account</div>
            @Body
        </div>
    </div>
</div>

@code {
    private GetUserDto? me;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            me = await UserService.GetUserAsync(await CurrentUser.GetIdAsync());
        }
        catch (UserNotFoundException)
        {
            Navigation.NavigateTo("/auth/session-expired", forceLoad: true);
        }
    }
}
