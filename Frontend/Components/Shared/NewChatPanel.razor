@inject ChatService ChatService
@inject FriendService FriendService
@inject CurrentUser CurrentUser
@inject NavigationManager Navigation

<div class="modal-backdrop" @onclick="OnClose">
    <div class="modal-box" @onclick:stopPropagation="true">
        <h3>New chat</h3>
        <p class="muted">Pick one friend for a private chat, or several for a group.</p>

        <input type="text" class="modal-search" placeholder="Search friends" @bind="search" @bind:event="oninput" />

        <div class="modal-friends">
            @foreach (var friend in VisibleFriends)
            {
                <label class="modal-friend @(selectedFriendIds.Contains(friend.UserId) ? "selected" : null)">
                    <Avatar Size="34" Color="#444" IconUrl="@friend.IconUrl" Name="@friend.Username" />
                    <span class="modal-friend-text">
                        <span class="modal-friend-name">@(friend.DisplayName ?? friend.Username)</span>
                        <span class="modal-friend-username">@@@friend.Username</span>
                    </span>
                    <input type="checkbox"
                           checked="@selectedFriendIds.Contains(friend.UserId)"
                           @onchange="args => ToggleFriend(friend.UserId, (bool)args.Value!)" />
                    <span class="modal-check"><i class="bi bi-check-lg"></i></span>
                </label>
            }
            @if (friends.Count == 0)
            {
                <p class="muted">Add friends first to start a chat.</p>
            }
            else if (!VisibleFriends.Any())
            {
                <p class="muted">No friends match your search.</p>
            }
        </div>

        @if (selectedFriendIds.Count >= 2)
        {
            <input type="text" class="modal-search" placeholder="Group name (optional)" @bind="groupName" @bind:event="oninput" />
        }

        @if (error is not null)
        {
            <p class="error-text">@error</p>
        }

        <div class="modal-actions">
            <button type="button" @onclick="OnClose">Cancel</button>
            <button type="button" class="primary" disabled="@(selectedFriendIds.Count == 0)" @onclick="CreateChatAsync">
                @(selectedFriendIds.Count >= 2 ? "Create group" : "Open chat")
            </button>
        </div>
    </div>
</div>

@code {
    [Parameter] public EventCallback OnClose { get; set; }

    private string search = string.Empty;
    private string groupName = string.Empty;
    private string? error;
    private List<GetFriendDto> friends = [];
    private readonly HashSet<Guid> selectedFriendIds = [];

    private IEnumerable<GetFriendDto> VisibleFriends => friends.Where(friend =>
        string.IsNullOrWhiteSpace(search)
        || friend.Username.Contains(search.Trim(), StringComparison.OrdinalIgnoreCase)
        || (friend.DisplayName?.Contains(search.Trim(), StringComparison.OrdinalIgnoreCase) ?? false));

    protected override async Task OnInitializedAsync()
    {
        friends = await FriendService.GetFriendsAsync(await CurrentUser.GetIdAsync());
    }

    private void ToggleFriend(Guid friendUserId, bool isSelected)
    {
        if (isSelected)
            selectedFriendIds.Add(friendUserId);
        else
            selectedFriendIds.Remove(friendUserId);
    }

    private async Task CreateChatAsync()
    {
        try
        {
            var currentUserId = await CurrentUser.GetIdAsync();
            var chat = selectedFriendIds.Count == 1
                ? await ChatService.OpenPrivateChatAsync(currentUserId, selectedFriendIds.First())
                : await ChatService.CreateGroupChatAsync(currentUserId, GetGroupName(), selectedFriendIds);

            await OnClose.InvokeAsync();
            Navigation.NavigateTo($"/chat/{chat.Id}");
        }
        catch (Exception exception)
        {
            error = ErrorMessage.For(exception);
        }
    }

    private string GetGroupName()
    {
        if (!string.IsNullOrWhiteSpace(groupName))
            return groupName.Trim();

        return string.Join(", ", friends
            .Where(friend => selectedFriendIds.Contains(friend.UserId))
            .Select(friend => friend.DisplayName ?? friend.Username));
    }
}
